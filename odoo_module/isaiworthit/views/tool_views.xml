<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tool_list" model="ir.ui.view">
        <field name="name">isaiworthit.tool.list</field>
        <field name="model">isaiworthit.tool</field>
        <field name="arch" type="xml">
            <list string="AI licences" editable="bottom">
                <field name="name"/>
                <field name="seats"/>
                <field name="cost_per_seat"/>
                <field name="monthly_cost" sum="Total"/>
                <field name="active_users"/>
                <field name="unused_seats" decoration-warning="unused_seats &gt; 0"/>
                <field name="unused_cost" decoration-warning="unused_cost &gt; 0"/>
                <field name="unit" optional="hide"/>
                <field name="minutes_per_action" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_tool" model="ir.actions.act_window">
        <field name="name">AI licences</field>
        <field name="res_model">isaiworthit.tool</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the AI tools you pay for</p>
            <p>Seats and price per seat give the licence costs. Minutes per use is the benchmark for time saved.</p>
        </field>
    </record>
</odoo>
