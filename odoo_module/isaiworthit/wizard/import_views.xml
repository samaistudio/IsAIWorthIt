<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_import_form" model="ir.ui.view">
        <field name="name">isaiworthit.import.form</field>
        <field name="model">isaiworthit.import</field>
        <field name="arch" type="xml">
            <form string="Import AI usage">
                <p class="text-muted">Users are matched to employees by work e-mail only to find their team.
                    Nothing is stored per person, and teams with fewer than 5 people are combined.
                    Licence costs use the seats and prices under AI licences today, also for past months.</p>
                <group>
                    <field name="usage_file" filename="usage_filename"/>
                    <field name="usage_filename" invisible="1"/>
                    <field name="survey_file" filename="survey_filename"/>
                    <field name="survey_filename" invisible="1"/>
                    <field name="hourly_cost"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_import" model="ir.actions.act_window">
        <field name="name">Import usage</field>
        <field name="res_model">isaiworthit.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
