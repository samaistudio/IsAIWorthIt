<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_isaiworthit" model="ir.module.category">
        <field name="name">IsAIWorthIt</field>
        <field name="sequence">60</field>
    </record>
    <record id="group_user" model="res.groups">
        <field name="name">Viewer: hours saved per team</field>
        <field name="category_id" ref="module_category_isaiworthit"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_manager" model="res.groups">
        <field name="name">Manager: costs, licences and import</field>
        <field name="category_id" ref="module_category_isaiworthit"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_month_company" model="ir.rule">
        <field name="name">IsAIWorthIt months: own companies</field>
        <field name="model_id" ref="model_isaiworthit_month"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_result_company" model="ir.rule">
        <field name="name">IsAIWorthIt results: own companies</field>
        <field name="model_id" ref="model_isaiworthit_result"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_tool_company" model="ir.rule">
        <field name="name">IsAIWorthIt tools: own companies</field>
        <field name="model_id" ref="model_isaiworthit_tool"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
